<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!--
      The hero stage. The focused app's own banner, dropped in at low opacity, is what fills the
      screen instead of empty black. The two scrims sit over it so type stays legible and the dock
      is seated rather than floating on top of artwork.
    -->
    <!--
      No banner image behind the hero name. Every leanback banner is the app's logo on a field, so
      scaled to fill the screen it reads as a watermark competing with the name rather than as
      atmosphere, and no amount of zoom hides that. The ambient glow carries the app's colour
      instead: same signal, no lettering.
    -->
    <View
        android:id="@+id/scrimLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the focused app's colour. Light spill, not a colour wash. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/ink"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/ink_mid"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/hairline" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:textColor="@color/ink_soft"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <!--
              The network name is a readout, not a button. Keeping it out of the Wi-Fi pill stops the
              pill changing width every minute and stops the label reading like an action.
            -->
            <LinearLayout
                android:id="@+id/topRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/netStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="18dp"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings" />
            </LinearLayout>
        </RelativeLayout>

        <!--
          The grid is clipped to this box, so a partially scrolled row can only ever be cut by the
          grid's own edge, never by the screen edge below the dock.
        -->
        <FrameLayout
            android:id="@+id/gridHolder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:alpha="0"
                android:descendantFocusability="afterDescendants" />

            <!--
              A scrolled row is always cut by one of these edges. Fading it reads as "there is more
              that way"; a hard slice reads as a rendering fault.
            -->
            <View
                android:id="@+id/gridFadeTop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/gridFadeBottom"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!--
          One home for the focused app's name, in one type size, always in the same place. It never
          moves between dock and grid, so focus changes never reflow the screen.
        -->
        <FrameLayout
            android:id="@+id/heroHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/ink"
                android:textSize="56sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />
        </FrameLayout>

        <!--
          The dock is a pinned layer, not row 0 of the grid. It never scrolls and never leaves.
        -->
        <FrameLayout
            android:id="@+id/dockHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dock_band"
            android:paddingTop="12dp"
            android:paddingBottom="26dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that travels between tiles and dock. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>