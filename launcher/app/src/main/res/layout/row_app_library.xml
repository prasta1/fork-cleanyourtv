<?xml version="1.0" encoding="utf-8"?>
<!-- The footer after the last row of apps: the app library button (config app_library) and the
     dark/light toggle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp"
    android:gravity="center" android:orientation="horizontal">
    <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
        android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps" />
    <TextView android:id="@+id/btnTheme" style="@style/TopButtonIcon"
        android:contentDescription="@string/toggle_dark_light"
        android:drawableStart="@drawable/ic_dark_mode" />
</LinearLayout>
