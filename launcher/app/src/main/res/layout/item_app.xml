<?xml version="1.0" encoding="utf-8"?>
<!--
  One tile. Used by both the grid and the dock, so a pinned app and a listed app are the same
  object at the same size. The focused app's name is not here: the hero caption owns naming, so
  there is exactly one place and one type size where a name appears.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Fallback for apps with no banner: the icon on a plate tinted from the app's own colour. -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>