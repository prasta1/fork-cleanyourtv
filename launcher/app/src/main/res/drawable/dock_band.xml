<?xml version="1.0" encoding="utf-8"?>
<!--
  The dock shelf.

  One shape, no separate highlight strip. A hairline drawn as its own layer-item is a square that
  spans the bounding box, so at the rounded corners it juts out over black with nothing under it.
  Letting the fill carry a gradient that lightens toward the top follows the rounded edge for free.

  The fill is lighter than tile_bg (#1C1C1E) so the shelf reads as raised, not sunken.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF34343A"
        android:centerColor="#FF2A2A2F"
        android:endColor="#FF232327"
        android:centerY="0.35"
        android:type="linear" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
</shape>